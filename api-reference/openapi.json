{
  "openapi": "3.0.3",
  "info": {
    "title": "Mindcare Oracle",
    "version": "1.0.0",
    "description": "Aggregated Multi-Exchange Liquidity Wall & Risk Audit with Cryptographic Proof."
  },
  "servers": [
    {
      "url": "https://api.mindcare.agency"
    }
  ],
  "paths": {
    "/analyze": {
      "post": {
        "summary": "Analyze Risk Endpoint",
        "operationId": "analyzeRisk",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "pair": {
                    "type": "string",
                    "description": "The trading pair you want the Oracle to analyze. Must be supported by Binance and Bybit.",
                    "example": "BTCUSDT"
                  }
                },
                "required": [
                  "pair"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Audit Response"
          },
          "402": {
            "description": "Payment Required via x402 Protocol"
          }
        }
      }
    }
  }
}
